    "慢慢逛，随便看看" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browsing at my own pace"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
